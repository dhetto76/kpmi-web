# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# react-router
/.react-router/

# production
/build
/.netlify

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel (kept: harmless if unused)
.vercel

# typescript
*.tsbuildinfo

# ...but the example is documentation and should be committed.
!.env.example

# Claude Code local settings
.claude/settings.local.json

# Supabase CLI local state (project linkage, cached versions)
supabase/.temp/

# Local dev screenshots
.hero-preview.png
