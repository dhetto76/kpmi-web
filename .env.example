# Supabase — from your project's API settings
# https://supabase.com/dashboard/project/_/settings/api
#
# VITE_-prefixed variables are inlined into the browser bundle. That is correct
# for the URL and anon key, which are public by design; RLS protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for admins to set user passwords.
# Never prefix with VITE_ — that would ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
